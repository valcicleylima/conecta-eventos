<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container py-4">
  <%- include('partials/messages') %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0">Inscrições do evento</h1>
      <p class="text-muted mb-0"><%= evento.titulo %></p>
    </div>
    <a href="/organizador/eventos" class="btn btn-outline-secondary">Voltar</a>
  </div>
  <div class="table-responsive bg-white shadow-sm rounded">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Participante</th>
          <th>Status inscrição</th>
          <th>Status pagamento</th>
          <th>Valor</th>
        </tr>
      </thead>
      <tbody>
        <% inscricoes.forEach(i => { %>
          <tr>
            <td><strong><%= i.nome %></strong><br><small class="text-muted"><%= i.email %></small></td>
            <td><%= i.status_inscricao %></td>
            <td><%= i.status_pagamento || 'pendente' %></td>
            <td>R$ <%= Number(i.valor || 0).toFixed(2).replace('.', ',') %></td>
          </tr>
        <% }) %>
        <% if (inscricoes.length === 0) { %>
          <tr><td colspan="4" class="text-center p-4">Nenhuma inscrição neste evento.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>
<%- include('partials/footer') %>
