<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container auth-container">
  <%- include('partials/messages') %>
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="h3 mb-3">Recuperar senha</h1>
          <form action="/esqueci-senha" method="POST">
            <div class="mb-3">
              <label class="form-label">E-mail cadastrado</label>
              <input type="email" name="email" class="form-control" required>
            </div>
            <button class="btn btn-primary w-100">Enviar código por e-mail</button>
          </form>
          <p class="mt-3 mb-0 text-center"><a href="/login">Voltar ao login</a></p>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
