<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container py-4">
  <%- include('partials/messages') %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Dashboard do organizador</h1>
    <a href="/organizador/eventos/novo" class="btn btn-primary">Novo evento</a>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card metric-card"><div class="card-body"><span>Meus eventos</span><strong><%= resumo.total %></strong></div></div></div>
    <div class="col-md-3"><div class="card metric-card"><div class="card-body"><span>Pendentes</span><strong><%= resumo.pendentes %></strong></div></div></div>
    <div class="col-md-3"><div class="card metric-card"><div class="card-body"><span>Aprovados</span><strong><%= resumo.aprovados %></strong></div></div></div>
    <div class="col-md-3"><div class="card metric-card"><div class="card-body"><span>Rejeitados</span><strong><%= resumo.rejeitados %></strong></div></div></div>
  </div>
  <%- include('partials/filtro_eventos_organizador', { filtros, action: '/organizador/dashboard' }) %>
  <%- include('meus_eventos_table', { eventos }) %>
</main>
<%- include('partials/footer') %>
