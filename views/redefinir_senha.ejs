<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container auth-container">
  <%- include('partials/messages') %>
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="h3 mb-3">Criar nova senha</h1>
          <form action="/redefinir-senha" method="POST">
            <div class="mb-3">
              <label class="form-label">E-mail</label>
              <input type="email" name="email" class="form-control" value="<%= email %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Código recebido</label>
              <input name="codigo" class="form-control" maxlength="6" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Nova senha</label>
              <input type="password" name="nova_senha" class="form-control" minlength="3" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Confirmar nova senha</label>
              <input type="password" name="confirmar_senha" class="form-control" minlength="3" required>
            </div>
            <button class="btn btn-primary w-100">Alterar senha</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
