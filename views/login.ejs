<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container auth-container">
  <%- include('partials/messages') %>
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="h3 mb-3">Entrar</h1>
          <form action="/login" method="POST">
            <div class="mb-3">
              <label class="form-label">E-mail</label>
              <input type="email" name="email" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Senha</label>
              <input type="password" name="senha" class="form-control" required>
            </div>
            <button class="btn btn-primary w-100">Acessar sistema</button>
          </form>
          <p class="mt-3 mb-1 text-center"><a href="/esqueci-senha">Esqueci minha senha</a></p>
          <p class="mb-0 text-center">Não tem conta? <a href="/cadastro">Cadastre-se</a></p>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
