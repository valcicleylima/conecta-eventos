<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container py-4">
  <%- include('partials/messages') %>
  <h1 class="h3 mb-4">Solicitações de organizador</h1>
  <form action="/admin/solicitacoes-organizador" method="GET" class="row g-2 mb-4">
    <div class="col-md-10">
      <input name="q" class="form-control" value="<%= filtros.q || '' %>" placeholder="Pesquisar por nome, e-mail, telefone, CPF/CNPJ, organização ou site">
    </div>
    <div class="col-md-2 d-grid">
      <button class="btn btn-primary">Pesquisar</button>
    </div>
  </form>
  <div class="row g-3">
    <% solicitacoes.forEach(s => { %>
      <div class="col-lg-6">
        <div class="card shadow-sm border-0">
          <div class="card-body">
            <h2 class="h5"><%= s.nome_completo %></h2>
            <p class="text-muted mb-2">Usuário cadastrado: <%= s.usuario_nome %> - <%= s.email %> - <%= s.telefone %></p>
            <p><strong>CPF/CNPJ:</strong> <%= s.cpf_cnpj %></p>
            <p><strong>Organização:</strong> <%= s.nome_organizacao %></p>
            <p><%= s.descricao_organizacao %></p>
            <% if (s.site_redes) { %><p><strong>Site/redes:</strong> <%= s.site_redes %></p><% } %>
            <form action="/admin/aprovar-organizador/<%= s.id %>" method="POST" class="d-inline">
              <button class="btn btn-success btn-sm">Aprovar</button>
            </form>
            <form action="/admin/rejeitar-organizador/<%= s.id %>" method="POST" class="d-inline" data-confirm="Rejeitar esta solicitação?">
              <button class="btn btn-outline-danger btn-sm">Rejeitar</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
    <% if (solicitacoes.length === 0) { %>
      <div class="col-12"><div class="alert alert-info">Nenhuma solicitação pendente.</div></div>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
